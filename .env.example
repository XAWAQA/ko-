# ==============================================================================
# Telegram Bot Configuration Template
# Copy this file to .env and replace with your actual production secrets:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Required: Telegram ID of the permanent Owner (Defaults to 1167798421)
OWNER_ID=1167798421

# Optional Server & Hardware settings (defaults to system cpu count & 8192MB)
MAX_RAM_MB=8192

# Optional Network & Facebook Graph API settings
GRAPH_API_BASE_URL="https://graph.facebook.com"
REQUEST_TIMEOUT=12.0
RETRY_ATTEMPTS=3

# Optional UI progress update interval in seconds
PROGRESS_UPDATE_INTERVAL=1.5
