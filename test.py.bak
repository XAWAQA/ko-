# Batch Settings
BATCH_SIZE = 9                          # Number of pages per batch
CONCURRENCY_PAGES = 9                   # Number of concurrent pages within batch
PAGE_CONV_LIMIT = 499                   # Number of conversations per request
HTTP_TIMEOUT = 120                      # HTTP timeout in seconds
RETRY_ATTEMPTS = 4                      # Number of retry attempts
MAX_BACKOFF_SECONDS = 30                # Maximum wait time between attempts



logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S",
